# Copy to .env and fill in. Keep secrets in .env.local (git-ignored, loaded before .env).

# ───────────────────────── Model relay (same relay as 3dcardagent) ─────────────────────────
# OpenAI-compatible relay (New API style). Serves /v1/chat/completions and /v1/messages.
RELAY_BASE_URL=https://www.cun.ai
# Never put the real key here — put it in .env.local:
#   RELAY_API_KEY=sk-...

# ───────────────────────── pi models (format provider/model[:thinking]) ─────────────────────────
# `relay/<id>` = any text model on the relay (`npm run model -- list`). Switch at runtime with
#   `npm run model -- coach relay/gemini-3-flash`; `npm run model -- reset` restores the defaults.
# coach: watches the game every few seconds (needs vision for screenshots; gemini/gpt/claude all do)
PI_MODEL=relay/gemini-2.5-flash-lite
# chat: buyer conversations on Termix
PI_CHAT_MODEL=relay/gemini-2.5-flash-lite
# off | minimal | low | medium | high
PI_THINKING=off

# ───────────────────────── Jev (TypeSafe System One) ─────────────────────────
# Jev makes the split-second in-game decisions. It is TypeSafe's own API — the relay does not
# serve it. Get a key at https://typesafe.ai and put it in .env.local:
#   TYPESAFE_API_KEY=...
# Without a key the buddy still plays (reflex policy + coach); the ops stream says "Jev offline".
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# ───────────────────────── AI cadence ─────────────────────────
# browser → server state reports per second
AI_OBSERVE_HZ=12
# Jev decisions per second (one request in flight at a time)
AI_JEV_HZ=4
# seconds between coach (LLM) rounds; each round may include a screenshot
AI_COACH_INTERVAL_SECONDS=10
AI_COACH_VISION=1

# ───────────────────────── Coins ─────────────────────────
# coins minted per 1 USD/USDC of order price (1 $ = 1 coin)
COINS_PER_DOLLAR=1
# one coin = one play session of up to this many minutes
COIN_SESSION_MINUTES=30
COIN_CODE_PREFIX=FC

# ───────────────────────── Play server ─────────────────────────
HTTP_PORT=8790
HTTP_HOST=0.0.0.0
# Public URL of the play page (goes into every delivery), e.g. https://play.example.com
PUBLIC_BASE_URL=http://localhost:8790
# Optional token for /admin and /api/admin/* from non-loopback addresses
ADMIN_TOKEN=
# Where ROMs live (git-ignored)
ROMS_DIR=./roms
DATA_DIR=./data

# ───────────────────────── Termix marketplace (only for selling) ─────────────────────────
# bsc | base | rh — each chain is a separate marketplace
AACP_CHAIN=bsc
# Key mode (unattended): put the dedicated hot-wallet private key into .env.local:
#   WALLET_KEY=0x...
A2A_RPC_URL=
# The agent to host (DB cuid): `npm run setup -- agents`
A2A_AGENT_ID=
SWEEP_INTERVAL_SECONDS=300
NOTIFY_WEBHOOK_URL=

# ───────────────────────── Listing ─────────────────────────
SERVICE_TITLE=AI Co-op Buddy for Classic NES Games (Jev FC Buddy)
SERVICE_PRICE=1
SERVICE_CURRENCY=USDC
SERVICE_DELIVERY_DAYS=1
SERVICE_CATEGORY=Games & Entertainment
SERVICE_SKILL_TAG=ai-game-buddy
