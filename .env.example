# Copy to .env and fill in. Keep secrets in .env.local (git-ignored, loaded before .env).

# ───────────────────────── Model relay: OpenRouter ─────────────────────────
# One OpenRouter key serves the buyer-chat model AND TypeSafe's Jev
# (System One endpoint /v1/systemone, beta). Any OpenAI-compatible relay works for chat.
RELAY_BASE_URL=https://openrouter.ai/api
# Never put the real key here — put it in .env.local:
#   RELAY_API_KEY=sk-or-v1-...

# ───────────────────────── pi model (format provider/model[:thinking]) ─────────────────────────
# `relay/<openrouter id>` = any text model on the relay (`npm run model -- list`). Switch at runtime with
#   `npm run model -- chat relay/google/gemini-3.1-flash-lite`; `npm run model -- reset` restores the default.
# OpenRouter prices ($/M tokens in/out, 2026-09):
#   google/gemini-2.5-flash-lite   0.10 / 0.40   default (vision, fast, cheap)
#   google/gemini-3.1-flash-lite   0.25 / 1.50
#   openai/gpt-5.4-mini            0.75 / 4.50
#   anthropic/claude-haiku-4.5     1.00 / 5.00
# chat: buyer conversations on Termix (the only LLM use; in-game decisions are Jev + reflexes)
PI_CHAT_MODEL=relay/google/gemini-2.5-flash-lite
# off | minimal | low | medium | high
PI_THINKING=off

# ───────────────────────── Jev (TypeSafe System One) ─────────────────────────
# Jev selects bounded tactical goals; local code handles movement and survival. By default it goes through the relay above
# (OpenRouter: $0.042/M input, ~70–500 ms). To use a direct TypeSafe account instead, set both in .env.local:
#   TYPESAFE_API_KEY=...            TYPESAFE_BASE_URL=https://api.typesafe.ai
# Without any key the buddy still plays (reflex policy); the ops stream says "Jev offline".
TYPESAFE_MODEL=jev-latest
# Jev price used for the per-coin cost estimate on the dashboard (USD per million tokens; OpenRouter lists
# $0.042/M input for jev-latest). The relay key usage on the dashboard is the authoritative bill.
JEV_PRICE_INPUT_PER_M=0.042
JEV_PRICE_OUTPUT_PER_M=0.042

# ───────────────────────── AI cadence ─────────────────────────
# browser → server state reports per second
AI_OBSERVE_HZ=24
# Jev request ceiling. Tactical choices use one in-flight call and at least 600 ms between calls.
AI_JEV_HZ=2

# ───────────────────────── Coins ─────────────────────────
# coins minted per 1 USD/USDC of order price (1 $ = 1 coin)
COINS_PER_DOLLAR=1
# one coin = a play window of this many minutes, counted from the moment the coin is inserted; the
# player may leave and come back while it runs. The operator dashboard can override this at runtime.
COIN_SESSION_MINUTES=10
COIN_CODE_PREFIX=FC

# ───────────────────────── Play server ─────────────────────────
HTTP_PORT=8790
HTTP_HOST=0.0.0.0
# Public URL of this API server (nginx front), e.g. https://fc.example.com
PUBLIC_BASE_URL=http://localhost:8790
# Public URL of the play page when it is hosted elsewhere (Vercel). When set and different from
# PUBLIC_BASE_URL the server stops serving web/ and redirects / there; deliveries link to it.
# Leave empty to serve the page from this server (local play).
PLAY_BASE_URL=
# Token for the operator dashboard and /api/admin/* (entered once in the dashboard page). REQUIRED behind
# a reverse proxy: without it every request that reaches the server from 127.0.0.1 (i.e. all of nginx's) counts as the operator.
ADMIN_TOKEN=
# Path of the operator page (default /admin). In production use a random one, e.g. /admin-<hex>.
ADMIN_PATH=
# Comma-separated page origins allowed to call /api/* and /ws from another host (the play page on
# Vercel, see web/config.js). Empty = same-origin only.
ALLOWED_ORIGINS=
# Where ROMs live (git-ignored)
ROMS_DIR=./roms
DATA_DIR=./data

# ───────────────────────── Termix marketplace (only for selling) ─────────────────────────
# bsc | base | rh — each chain is a separate marketplace
AACP_CHAIN=bsc
# Key mode (unattended): put the dedicated hot-wallet private key into .env.local:
#   WALLET_KEY=0x...
A2A_RPC_URL=
# The agent to host (DB cuid): `npm run setup -- agents`
A2A_AGENT_ID=
SWEEP_INTERVAL_SECONDS=300
NOTIFY_WEBHOOK_URL=

# ───────────────────────── Listing ─────────────────────────
SERVICE_TITLE=AI Co-op Buddy for Classic NES Games (Jev FC Buddy)
SERVICE_PRICE=1
SERVICE_CURRENCY=USDC
SERVICE_DELIVERY_DAYS=1
# Termix listing categories (2026-09): Code & Smart Contracts, Security & Verification, Data & Research, Design & Brand,
# Writing & Content, Automation & Ops, Market & Protocol Research, Model & Dataset Ops. No games category exists.
SERVICE_CATEGORY=Automation & Ops
SERVICE_SKILL_TAG=ai-game-buddy
