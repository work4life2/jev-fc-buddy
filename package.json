{
  "name": "jev-fc-buddy",
  "version": "0.1.0",
  "description": "AI co-op buddy for classic NES games, sold as coin codes on the Termix agent marketplace. pi agent harness + TypeSafe Jev for in-game decisions + termix-agent-skills for orders.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev-fc-buddy": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-vendor.mjs",
    "start": "node dist/index.js serve",
    "serve": "node dist/index.js serve",
    "dev": "npm run build && node dist/index.js serve",
    "doctor": "node dist/index.js doctor",
    "setup": "node dist/index.js setup",
    "code": "node dist/index.js code",
    "model": "node dist/index.js model",
    "pi": "node dist/index.js pi",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "jsnes": "^2.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3"
  }
}
